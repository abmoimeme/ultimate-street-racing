{
  "rules": {
    ".read": false,
    ".write": false,
    "usr": {
      "rooms": {
        "$room": {
          ".read": "$room.matches(/^usr-(tokyo|dakar)$/)",
          "$peer": {
            ".write": "$room.matches(/^usr-(tokyo|dakar)$/) && $peer.matches(/^[a-z0-9]{6,24}$/)",
            ".validate": "!newData.exists() || (newData.hasChildren(['t']) && newData.child('t').isNumber())"
          }
        }
      },
      "lobby": {
        "$peer": {
          ".write": "$peer.matches(/^[a-z0-9]{6,24}$/)"
        }
      },
      "lb": {
        ".read": true,
        ".indexOn": ["rep", "t_tokyo_intro", "t_tokyo_raceA", "t_tokyo_raceB", "t_tokyo_drag", "t_dakar_intro", "t_dakar_raceA", "t_dakar_raceB", "t_dakar_drag"],
        "$uid": {
          ".write": "$uid.matches(/^[a-z0-9]{12,24}$/)",
          ".validate": "newData.hasChildren(['n', 'rep']) && newData.child('n').isString() && newData.child('n').val().length <= 18 && newData.child('rep').isNumber()"
        }
      }
    }
  }
}
